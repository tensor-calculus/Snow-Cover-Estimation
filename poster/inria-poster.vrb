                \begin{table}[!htbp]
              \caption{Model metrics along with \citet{briand2026weakly}}
              \label{tab:results}
              \vspace{-1.4em}
              \centering
              \renewcommand{\arraystretch}{0.92}
              \resizebox{\textwidth}{!}{%
              \begin{tabular}{llcccc}
                \toprule
                Scenario \& Method & Channels & $\text{F1}_{\text{Snow}}$ ($\uparrow$) & $\text{IoU}_{\text{Snow}}$ ($\uparrow$) & Macro F1 ($\uparrow$) & Overall F1 ($\uparrow$) \\
                \midrule
                \multicolumn{6}{l}{\emph{A. Same-Basin Temporal Generalization}} \\
                \citet{briand2026weakly} & Set~B (4-ch) & 84.70\% & 0.7346 & 80.30\% & 81.50\% \\
                Model~1: Raw C-Band (Baseline) & Set~A (2-ch) & 56.84\% & 0.3970 & 77.02\% & 94.80\% \\
                Model~2: C-Band + Summer MLE & Set~B (4-ch) & 67.10\% & 0.5049 & 82.58\% & 96.25\% \\
                Model~3: C-Band + MLE + DEM & Set~B+DEM (6-ch) & \textbf{69.27\%} & \textbf{0.5299} & \textbf{83.68\%} & \textbf{96.48\%} \\
                \midrule
                \multicolumn{6}{l}{\emph{B. Unseen-Basin Spatial Transfer}} \\
                \citet{briand2026weakly} & Set~B (4-ch) & 74.40\% & 0.5924 & 71.05\% & 71.30\% \\
                Model~1: Raw C-Band (Baseline) & Set~A (2-ch) & 43.34\% & 0.2767 & 68.18\% & 87.08\% \\
                Model~2: C-Band + Summer MLE & Set~B (4-ch) & 46.46\% & 0.3026 & 70.79\% & 89.27\% \\
                Model~3: C-Band + MLE + DEM & Set~B+DEM (6-ch) & \textbf{50.42\%} & \textbf{0.3371} & \textbf{72.82\%} & \textbf{89.83\%} \\
                \bottomrule
              \end{tabular}%
              }
            \end{table}
            \vspace{10pt}

            \begin{table}[!htbp]
              \caption{Elevation wise metrics for unseen test patch}
              \label{tab:elevation_results}
              \vspace{-1.4em}
              \centering
              \renewcommand{\arraystretch}{0.92}
              \resizebox{\textwidth}{!}{%
              \begin{tabular}{llccc}
                \toprule
                Elevation Zone (\texttt{patch\_test}) & Metric & Model~1 (2-ch) & Model~2 (4-ch) & Model~3 (6-ch) \\
                \midrule
                $<3000\text{ m}$ (Snow-Free Valleys) & Accuracy ($\text{F1}_{\text{NoSnow}}$) & 96.42\% & 99.93\% & \textbf{100.00\%} \\
                $3000\text{--}4000\text{ m}$ (Lower Transition) & $\text{F1}_{\text{Snow}}$ / $\text{IoU}_{\text{Snow}}$ & 25.35\% / 0.1451 & 24.73\% / 0.1411 & \textbf{25.87\%} / \textbf{0.1486} \\
                $4000\text{--}5000\text{ m}$ (Mid-Alpine Zone) & $\text{F1}_{\text{Snow}}$ / $\text{IoU}_{\text{Snow}}$ & 50.97\% / 0.3420 & 51.32\% / 0.3452 & \textbf{55.35\%} / \textbf{0.3827} \\
                $>5000\text{ m}$ (High-Alpine Core) & $\text{F1}_{\text{Snow}}$ / $\text{IoU}_{\text{Snow}}$ & \textbf{73.08\%} / \textbf{0.5758} & 66.79\% / 0.5014 & 70.29\% / 0.5420 \\
                \bottomrule
              \end{tabular}%
              }
            \end{table}
            \end{findingblock}

