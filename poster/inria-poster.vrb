              \vspace{-1.4em}
              \centering
              \renewcommand{\arraystretch}{0.92}
              \resizebox{\textwidth}{!}{%
              \begin{tabular}{llcccc}
                \toprule
                Scenario \& Method & Channels & $\text{F1}_{\text{Snow}}$ ($\uparrow$) & $\text{IoU}_{\text{Snow}}$ ($\uparrow$) & Macro F1 ($\uparrow$) & Overall F1 ($\uparrow$) \\
                \midrule
                \multicolumn{6}{l}{\emph{A. Same-Basin Temporal Generalization}} \\
                Briand et al.\ (European Alps) & Set~B (4-ch) & \textbf{84.70\%} & \textbf{0.7346} & 80.30\% & 81.50\% \\
                Model~1: Raw C-Band (Baseline) & Set~A (2-ch) & 56.84\% & 0.3970 & 77.02\% & 94.80\% \\
                Model~2: C-Band + Summer MLE & Set~B (4-ch) & 67.10\% & 0.5049 & 82.58\% & 96.25\% \\
                Model~3: C-Band + MLE + DEM & Set~B+DEM (6-ch) & 69.27\% & 0.5299 & \textbf{83.68\%} & \textbf{96.48\%} \\
                \midrule
                \multicolumn{6}{l}{\emph{B. Unseen-Basin Spatial Transfer}} \\
                Briand et al.\ (European Alps) & Set~B (4-ch) & \textbf{74.40\%} & \textbf{0.5924} & 71.05\% & 71.30\% \\
                Model~1: Raw C-Band (Baseline) & Set~A (2-ch) & 43.34\% & 0.2767 & 68.18\% & 87.08\% \\
                Model~2: C-Band + Summer MLE & Set~B (4-ch) & 46.46\% & 0.3026 & 70.79\% & 89.27\% \\
                Model~3: C-Band + MLE + DEM & Set~B+DEM (6-ch) & 50.42\% & 0.3371 & \textbf{72.82\%} & \textbf{89.83\%} \\
                \bottomrule
              \end{tabular}%
              }
            \end{table}
