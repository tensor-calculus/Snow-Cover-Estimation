      % TL;DR section for the main findings
      \begin{columns}[t]
        \begin{column}{0.32\linewidth}
          \begin{inriablock}{}
            \large Snow cover estimation has always been a difficult problem to solve...\raggedright
          \end{inriablock}
        \end{column}%\hfill
        \begin{column}{0.32\linewidth}
          \begin{inriablock}{}
            \large \ldots First there were optical based methods, \tcblower \large \textbf{but they didn't work when there were clouds!}
          \end{inriablock}
        \end{column}%\hfill
        \begin{column}{0.32\linewidth}
          \begin{inriablock}{}
            \large Hence SAR based methods were created... \textcolor{inria-rouge}{\textbf{This project proposes one such method!}}
          \end{inriablock}
        \end{column}
      \end{columns}

      % Line above context and below the sentences, extending across the whole page
      \vskip 1ex
      \noindent\begin{tikzpicture}
        \shade[inria degrade, rounded corners=2pt] (0,0) rectangle (\linewidth, \filetheight);
      \end{tikzpicture}\par
      \vskip 1ex
      % Main content
      \begin{columns}[T]
        \begin{column}{.485\linewidth}
          \begin{inriastartblock}{Context}
            \begin{itemize}
              \item Nothing beats snow cover estimated using optical images when the sky is clear!
              \item But the sky is not always clear, during winter, $>50\%$ of the sky over a region can be covered by clouds.
              \item Synthetic Aperture Radar (SAR) is an active remote sensing technique that penetrates right through clouds!
              \item However, raw winter SAR images struggle to distinguish snow from ground on its own.
              \item Enter Deep Learning - we can teach a model to spot snow in any weather! We just need summer SAR images, DEM and labels.
            \end{itemize}
        \end{inriastartblock}
        \begin{inriablock}{Weakly Supervised Framework}
            \begin{figure}[!htbp]
              \centering
              \begin{tikzpicture}[node distance=0.75cm and 1.5cm]
                % -------------------------------------------------------------
                % 1. Training Phase (Clear-Sky Days)
                % -------------------------------------------------------------
                % Row 1: Optical weak label branch
                \node[tbox_optical, text width=6.3cm, minimum height=1.65cm] (s2) {\textbf{Sentinel-2}\\[2pt]\small(Optical)};
                \node[tbox_optical, text width=6.3cm, minimum height=1.65cm, right=1.5cm of s2] (lis) {\textbf{Let-It-Snow}};
                \draw[tarrow] (s2) -- (lis);

                % Row 2: SAR forward pass branch
                \node[tbox_sar, text width=6.3cm, minimum height=1.65cm, below=0.75cm of s2] (s1) {\textbf{Sentinel-1}\\[2pt]\small(SAR)};
                \node[tbox_model, text width=6.3cm, minimum height=1.65cm, right=1.5cm of s1] (unet) {\textbf{U-Net Model}\\[2pt]\small(Segmentation)};
                \node[tbox_output, text width=6.3cm, minimum height=1.65cm, right=1.5cm of unet] (pred) {\textbf{Predicted}\\[2pt]\textbf{Snow Map}};
                \node[tbox_loss, text width=6.3cm, minimum height=1.65cm, right=1.5cm of pred] (loss) {\textbf{Loss Function}\\[2pt]\small(Cross-Entropy)};

                \draw[tarrow] (s1) -- node[midway, above=-1pt, font=\footnotesize\itshape] {} (unet);
                \draw[tarrow] (unet) -- (pred);
                \draw[tarrow] (pred) -- (loss);

                % Connect LIS weak labels to Loss Calculation (supervision target)
                \draw[tdash] (lis.east) -| node[pos=0.4, above, font=\small\bfseries, text=inria-2024-framboise] {Weak Labels} (loss.north);

                % Training loop feedback: backpropagation to U-Net
                \coordinate (loopb) at ($(loss.south)+(0,-0.65cm)$);
                \draw[tarrow, draw=inria-rouge] (loss.south) -- (loopb) -- (loopb -| unet.south) node[midway, below=2pt, font=\small\bfseries, text=inria-rouge] (looplabel) {Backpropagation (Training Loop)} -- (unet.south);

                % Group box for Training Phase (fully enclosing feedback loop and label)
                \node[tgroup, fit=(s2)(s1)(lis)(unet)(pred)(loss)(looplabel), label={[font=\normalsize\bfseries, text=inria-2024-bleu-nuit]above:\textbf{1. Training Phase}}] (gtrain) {};

                % -------------------------------------------------------------
                % 2. Inference Phase (All-Weather / Cloudy)
                % -------------------------------------------------------------
                \node[tbox_model, text width=7.0cm, minimum height=1.65cm, below=2.1cm of gtrain.south] (unett) {\textbf{Trained U-Net}};
                \node[tbox_sar, text width=7.0cm, minimum height=1.65cm, left=1.6cm of unett] (s1t) {\textbf{Sentinel-1}\\[2pt]\small(SAR)};
                \node[tbox_output, text width=7.0cm, minimum height=1.65cm, right=1.6cm of unett] (out) {\textbf{Snow Cover Map}};

                \draw[tarrow] (s1t) -- node[midway, above=-1pt, font=\footnotesize\itshape] {} (unett);
                \draw[tarrow] (unett) -- (out);

                \node[tgroup, fit=(s1t)(unett)(out), inner xsep=14pt, inner ysep=5pt, label={[font=\normalsize\bfseries, text=inria-2024-bleu-nuit]above:\textbf{2. Inference Phase}}] (ginf) {};
              \end{tikzpicture}
              \vspace{0.2em}
              \label{fig:concept}
            \end{figure}
          \end{inriablock}

          \begin{inriablock}{Defining the Objectives:}
            \begin{enumerate}
              \item Build reusable satellite image preprocessing pipeline ($70\%$ of the work 'cause satellite images contain too much information!). \ding{51}
              \item Generate labels needed to train the model using optical images (hence weakly supervised). \ding{51}
              \item Train model on C-band (+ summer MLE \& DEM) and get elevation-wise metrics. \ding{51}
              \item Train model on S-band (NISAR) and get elevation-wise metrics.
              \item Prove they are complementary and devise a novel approach to combine them!
              \item Use the new model to outperform previous best-performing model of Briand et al.
              \item Package everything into a GUI for demonstration.
            \end{enumerate}
          \end{inriablock}

          \begin{inriablock}{Laying out the Timeline (Phase II)}
            \begin{itemize}
                \item S-band \& C+S fusion results by end of February 2027.
                  \begin{itemize}
                    \item Either positive or negative result. Both are meaningful!
                  \end{itemize}
                \item Submit paper by end of March 2027.
                \item Create GUI by end of April 2027.
                  \begin{itemize}
                    \item Time taken $\propto$ no.\ of external dependencies (because they have a tendency not to cooperate!).
                  \end{itemize}
              \end{itemize}
          \end{inriablock}

          \begin{inriablock}{About the Data...}
            \begin{itemize}
              \item \textbf{Study Area:} Himalayan basins in Himachal Pradesh \& Ladakh, India (each scene is a distinct acquisition date):
                \begin{itemize}
                  \item Winter scenes: 5 training ($133\text{k}$ patches), 1 validation ($6.6\text{k}$ patches), 1 unseen test ($10.7\text{k}$ patches).
                  \item Snow-free summer references (Rayleigh MLE): 6 training scenes, 5 testing scenes.
                \end{itemize}
              \item \textbf{Optical (Labels):} Sentinel-2 L2A ($20\,\text{m}$ bands resampled to $10\,\text{m}$ via Let-It-Snow).
              \item \textbf{SAR C-band:} Sentinel-1 IW GRD (VV \& VH at $10\,\text{m} \times 10\,\text{m}$ resolution).
              \item \textbf{DEM:} Copernicus GLO-30 (derived from TanDEM-X, warped from $30\,\text{m}$ to $10\,\text{m}$).
              \item All products are free and open-access under the Copernicus data license!
            \end{itemize}
          \end{inriablock}

