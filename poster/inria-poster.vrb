              \resizebox{\textwidth}{!}{%
              \begin{tabular}{llccc}
                \toprule
                Elevation Zone & Metric & Model~1 (2-ch) & Model~2 (4-ch) & Model~3 (6-ch) \\
                \midrule
                $<3000\text{ m}$ (Snow-Free Valleys) & Accuracy ($\text{F1}_{\text{NoSnow}}$) & 96.42\% & 99.93\% & \textbf{100.00\%} \\
                $3000\text{--}4000\text{ m}$ (Lower Transition) & $\text{F1}_{\text{Snow}}$ / $\text{IoU}_{\text{Snow}}$ & 25.35\% / 0.1451 & 24.73\% / 0.1411 & \textbf{25.87\%} / \textbf{0.1486} \\
                $4000\text{--}5000\text{ m}$ (Mid-Alpine Zone) & $\text{F1}_{\text{Snow}}$ / $\text{IoU}_{\text{Snow}}$ & 50.97\% / 0.3420 & 51.32\% / 0.3452 & \textbf{55.35\%} / \textbf{0.3827} \\
                $>5000\text{ m}$ (High-Alpine Core) & $\text{F1}_{\text{Snow}}$ / $\text{IoU}_{\text{Snow}}$ & \textbf{73.08\%} / \textbf{0.5758} & 66.79\% / 0.5014 & 70.29\% / 0.5420 \\
                \bottomrule
              \end{tabular}%
              }
