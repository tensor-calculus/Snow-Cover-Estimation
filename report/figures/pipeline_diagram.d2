direction: down

vars: {
  d2-config: {
    layout-engine: dagre
    pad: 10
  }
}

style: {
  fill: "#ffffff"
}

inputs: "Input Channel Combinations" {
  style: {
    fill: "#ffffff"
    stroke: "#000000"
    stroke-width: 2
    border-radius: 4
    font-size: 21
    font-color: "#000000"
    bold: true
  }

  m1: "Model 1 (2-ch)\nWinter SAR" {
    style: { fill: "#ffffff"; stroke: "#000000"; stroke-width: 2; border-radius: 4; font-size: 20; font-color: "#000000"; bold: false }
  }
  m2: "Model 2 (4-ch)\n+ Summer Reference" {
    style: { fill: "#ffffff"; stroke: "#000000"; stroke-width: 2; border-radius: 4; font-size: 20; font-color: "#000000"; bold: false }
  }
  m3: "Model 3 (6-ch)\n+ Elevation & Slope" {
    style: { fill: "#ffffff"; stroke: "#000000"; stroke-width: 2; border-radius: 4; font-size: 20; font-color: "#000000"; bold: false }
  }
}

unet: "3-Stage U-Net" {
  style: { fill: "#ffffff"; stroke: "#000000"; stroke-width: 2; border-radius: 4; font-size: 20; font-color: "#000000"; bold: false }
}

loss: "Weighted CE Loss\n(Training)" {
  style: { fill: "#ffffff"; stroke: "#000000"; stroke-width: 2; border-radius: 4; font-size: 20; font-color: "#000000"; bold: false }
}

thresh: "Threshold Selection\n(Validation)" {
  style: { fill: "#ffffff"; stroke: "#000000"; stroke-width: 2; border-radius: 4; font-size: 20; font-color: "#000000"; bold: false }
}

infer: "Gaussian Blending\n(Test Snow Map)" {
  style: { fill: "#ffffff"; stroke: "#000000"; stroke-width: 2; border-radius: 4; font-size: 20; font-color: "#000000"; bold: false }
}

inputs.m1 -> unet: { style.stroke: "#000000"; style.stroke-width: 2 }
inputs.m2 -> unet: { style.stroke: "#000000"; style.stroke-width: 2 }
inputs.m3 -> unet: { style.stroke: "#000000"; style.stroke-width: 2 }

unet -> loss: "Train" { style.stroke: "#000000"; style.stroke-width: 2; style.font-size: 18; style.font-color: "#000000"; style.bold: false }
unet -> thresh: "Val" { style.stroke: "#000000"; style.stroke-width: 2; style.font-size: 18; style.font-color: "#000000"; style.bold: false }
unet -> infer: "Test" { style.stroke: "#000000"; style.stroke-width: 2; style.font-size: 18; style.font-color: "#000000"; style.bold: false }
